rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Ogni utente legge/scrive SOLO il proprio documento, con forma e dimensione controllate.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['d'])
        && request.resource.data.d is map
        && request.resource.data.d.keys().hasOnly(['days', 'kgoal', 'fmax'])
        && request.resource.data.d.days is map
        && request.resource.data.d.days.size() <= 3700
        && request.resource.data.d.kgoal is number
        && request.resource.data.d.fmax is number;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
